<odoo>
    <record
        id="stock_picking_terms_res_config_settings_view_form_inherit_account"
        model="ir.ui.view"
    >
        <field
            name="name"
        >stock.picking.terms.res.config.settings.view.form.inherit.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='reception_report']" position="after">
                <setting
                    id="terms_and_conditions"
                    string="Terms and Conditions"
                    groups="stock.group_stock_manager"
                    company_dependent="1"
                >
                    <div class="text-muted">
                        Add your default terms &amp; conditions at the bottom of
                        Delivery Slip reports depending on the type of operation.
                    </div>
                    <field
                        name="stock_picking_terms"
                        class="oe_account_terms mt-5 w-100"
                        placeholder="Insert your terms &amp; conditions here..."
                    />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
